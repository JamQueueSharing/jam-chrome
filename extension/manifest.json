{
  "manifest_version": 3,
  "name": "Morphe Jam for YouTube Music",
  "description": "Host and join Morphe Jam sessions from YouTube Music. Requires the local Jam helper.",
  "version": "0.2.1",
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging", "scripting"],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Morphe Jam" },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["keyboard-guard.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["vendor/lucide.min.js", "vendor/qr.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
